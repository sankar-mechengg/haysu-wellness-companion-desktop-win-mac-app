{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Haysu",
  "version": "1.3.1",
  "identifier": "com.haysu.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://github.com https://*.github.com https://objects.githubusercontent.com",
      "devCsp": "default-src 'self' http://localhost:1420 ws://localhost:1420 ws://localhost:1421 data: blob:; script-src 'self' http://localhost:1420 'unsafe-inline' 'unsafe-eval'; style-src 'self' http://localhost:1420 'unsafe-inline'; img-src 'self' data: blob: http://localhost:1420; media-src 'self' blob:; font-src 'self' data: http://localhost:1420; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421"
    },
    "windows": [
      {
        "label": "widget",
        "title": "Haysu",
        "visible": false,
        "width": 260,
        "height": 56,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "center": true,
        "url": "/?window=widget"
      },
      {
        "label": "popup",
        "title": "Haysu Reminder",
        "visible": false,
        "width": 440,
        "height": 260,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "url": "/?window=popup"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Healthcare and Fitness",
    "shortDescription": "Desktop wellness companion",
    "longDescription": "Water reminders, guided movement breaks and a Pomodoro timer that live in your system tray.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "fileAssociations": [
      {
        "ext": ["hay"],
        "name": "Haysu backup",
        "description": "Haysu backup archive",
        "role": "Editor",
        "mimeType": "application/x-haysu-backup"
      },
      {
        "ext": ["su"],
        "name": "Haysu snapshot",
        "description": "Haysu health snapshot",
        "role": "Editor",
        "mimeType": "application/x-haysu-snapshot"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFFQzZBNjgzOTQyQTYxREUKUldUZVlTcVVnNmJHcnFWVHpqdDVaRVJSbWRJbk13NW00MW9iVGVlWk5IdHN6RHpFOFljdlptUnQK",
      "endpoints": [
        "https://github.com/sankar-mechengg/haysu-wellness-companion-desktop-win-mac-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
